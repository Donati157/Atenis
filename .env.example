NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: necessária pra trocar senha de usuários (painel admin).
# Pega em: Supabase Dashboard → Settings → API → service_role key.
# NUNCA expor no cliente — só usar em route handlers / server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Provider principal de IA — OpenAI direto via @ai-sdk/openai.
# Todas as rotas /api/* (chat, enem, ap, gcd, study-plan) usam esta chave.
OPENAI_API_KEY=your-openai-api-key

# Opcional — Vercel AI Gateway. Preservado no código como fallback futuro
# (VercelAIGatewayProvider), mas não é o provider ativo do Runtime hoje.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key
